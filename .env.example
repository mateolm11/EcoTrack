# ==============================================================
# EcoTrack - Plantilla de Variables de Entorno (.env.example)
# NOTA: Nunca colocar contraseñas ni claves reales en este archivo.
# Copiar este archivo como .env para configuración local.
# En proveedores cloud (Railway / PaaS), configurar en el panel de variables.
# ==============================================================

# Entorno de la aplicación ('local' o 'produccion' / 'development' o 'production')
ENTORNO=local
APP_ENV=development

# Conexión a la Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecotrack
DB_USER=root
DB_PASS=

# Configuración opcional de CORS (dejar vacío si frontend y API comparten dominio)
CORS_ORIGIN=

# Notificaciones por email con Resend (dejar vacío para modo simulación en api/avisos.log)
RESEND_API_KEY=
EMAIL_AVISOS=

# Endpoints de servicios externos (Open-Meteo)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
